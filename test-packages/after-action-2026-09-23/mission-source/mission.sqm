																																		class Item342
																																		{
																																			dataType="Object";
																																			class PositionInfo
																																			{
																																				position[]={623.37958,271.67957,282.2186};
																																				angles[]={0,1.6276195,0};
																																			};
																																			side="Empty";
																																			flags=5;
																																			class Attributes
																																			{
																																				init="this addAction [""View Master Spawn Report"", {  " \n "    private _msg = ""=== Master Spawn Report ===\n\n"";  " \n "  " \n "    if (isNil ""FST_spawnCounts"" || {count (keys FST_spawnCounts) == 0}) then {  " \n "        _msg = _msg + ""No vehicles have been spawned yet.\n"";  " \n "    } else {  " \n "        _msg = _msg + ""Vehicle Spawns:\n"";  " \n "        {  " \n "            _msg = _msg + format ["" • %1 : %2\n"", _x, FST_spawnCounts get _x];  " \n "        } forEach (keys FST_spawnCounts);  " \n "    };  " \n "  " \n "    _msg = _msg + ""\n"";  " \n "  " \n "    if (isNil ""CrateStats"" || {count CrateStats == 0}) then {  " \n "        _msg = _msg + ""No crates have been dispensed yet.\n"";  " \n "    } else {  " \n "        _msg = _msg + ""Crate Dispenses:\n"";  " \n "        {  " \n "            _msg = _msg + format ["" • %1 : %2\n"", _x select 0, _x select 1];  " \n "        } forEach CrateStats;  " \n "    };  " \n "  " \n "    hint _msg;  " \n "}];  " \n " " \n "  " \n "this addAction [  " \n "    ""Pull down LAAT/C 1"",  " \n "    {  " \n "        _spawnerObj = missionNamespace getVariable [""LAATCSpawner1"", objNull];  " \n "        if (isNull _spawnerObj) exitWith { hint ""Spawner 1 not found!""; };  " \n "  " \n "        _hideObj = missionNamespace getVariable [""LAATC1"", objNull];  " \n "        if (!isNull _hideObj) then { _hideObj hideObjectGlobal true; };  " \n "  " \n "        _veh = createVehicle [""FST_LAATC"", getPosATL _spawnerObj, [], 0, ""NONE""];  " \n "        _veh setDir getDir _spawnerObj;  " \n "        _veh setPosATL getPosATL _spawnerObj;  " \n "    }  " \n "];  " \n "  " \n "  " \n "this addAction [  " \n "    ""Pull down LAAT/C 2"",  " \n "    {  " \n "        _spawnerObj = missionNamespace getVariable [""LAATCSpawner2"", objNull];  " \n "        if (isNull _spawnerObj) exitWith { hint ""Spawner 2 not found!""; };  " \n "  " \n "        _hideObj = missionNamespace getVariable [""LAATC2"", objNull];  " \n "        if (!isNull _hideObj) then { _hideObj hideObjectGlobal true; };  " \n "  " \n "        _veh = createVehicle [""FST_LAATC"", getPosATL _spawnerObj, [], 0, ""NONE""];  " \n "        _veh setDir getDir _spawnerObj;  " \n "        _veh setPosATL getPosATL _spawnerObj;  " \n "    }  " \n "];  " \n "  " \n "  " \n "  " \n "this addAction [  " \n "    ""Pull down LAAT/C 3"",  " \n "    {  " \n "        _spawnerObj = missionNamespace getVariable [""LAATCSpawner3"", objNull];  " \n "        if (isNull _spawnerObj) exitWith { hint ""Spawner 3 not found!""; };  " \n "  " \n "        _hideObj = missionNamespace getVariable [""LAATC3"", objNull];  " \n "        if (!isNull _hideObj) then { _hideObj hideObjectGlobal true; };  " \n "  " \n "        _veh = createVehicle [""FST_LAATC"", getPosATL _spawnerObj, [], 0, ""NONE""];  " \n "        _veh setDir getDir _spawnerObj;  " \n "        _veh setPosATL getPosATL _spawnerObj;  " \n "    }  " \n "];  " \n " " \n "  " \n "if (isNil ""CrateStats"") then {  " \n "    CrateStats = [  " \n "        [""Ammo"", 0],  " \n "        [""Medical"", 0],  " \n "        [""Explosive"", 0],  " \n "        [""Fuel"", 0]  " \n "    ];  " \n "};  " \n "  " \n "  " \n "addCrateStat = {  " \n "    params [""_type""];  " \n "    {  " \n "        if ((_x select 0) isEqualTo _type) exitWith {  " \n "            _x set [1, (_x select 1) + 1];  " \n "        };  " \n "    } forEach CrateStats;  " \n "};  " \n "  " \n "  " \n "showCrateReport = {  " \n "    private _report = ""📊 Dispenser Report\n\n"";  " \n "    {  " \n "        _report = _report + format [""%1 Crates: %2\n"", _x select 0, _x select 1];  " \n "    } forEach CrateStats;  " \n "    hint _report;  " \n "};  " \n "  " \n "  " \n "  " \n "this addAction [""Dispense Ammo Crate"", {  " \n "    _veh = nearestObjects [ammospawn, [""Helicopter"", ""Plane""], 10] select 0;  " \n "    sleep 0.5;  " \n "  " \n "    _pad1 = getPosATL ammospawn;  " \n "    _dir = getDir ammospawn;  " \n "    _veh = createVehicle [""FST_AMMOCRATE"", _pad1, [], 0, ""CAN_COLLIDE""];  " \n "    _veh setDir _dir;  " \n "  " \n "    [""Ammo""] call addCrateStat;  " \n "    hint ""Ammo Crate Dispensed!"";  " \n "}];  " \n "  " \n "this addAction [""Dispense Medical Crate"", {  " \n "    _veh = nearestObjects [medspawn, [""Helicopter"", ""Plane""], 10] select 0;  " \n "    sleep 0.5;  " \n "  " \n "    _pad1 = getPosATL medspawn;  " \n "    _dir = getDir medspawn;  " \n "    _veh = createVehicle [""FST_MEDICALCRATE"", _pad1, [], 0, ""CAN_COLLIDE""];  " \n "    _veh setDir _dir;  " \n "  " \n "    [""Medical""] call addCrateStat;  " \n "    hint ""Medical Crate Dispensed!"";  " \n "}];  " \n "  " \n "this addAction [""Dispense Explosive Crate"", {  " \n "    _veh = nearestObjects [explospawn, [""Helicopter"", ""Plane""], 10] select 0;  " \n "    sleep 0.5;  " \n "  " \n "    _pad1 = getPosATL explospawn;  " \n "    _dir = getDir explospawn;  " \n "    _veh = createVehicle [""FST_EXPLOSIVECRATE"", _pad1, [], 0, ""CAN_COLLIDE""];  " \n "    _veh setDir _dir;  " \n "  " \n "    [""Explosive""] call addCrateStat;  " \n "    hint ""Explosive Crate Dispensed!"";  " \n "}];  " \n "  " \n "this addAction [""Dispense Fuel Barrel"", {  " \n "    _veh = nearestObjects [fuelspawn, [""Helicopter"", ""Plane""], 10] select 0;  " \n "    sleep 0.5;  " \n "  " \n "    _pad1 = getPosATL fuelspawn;  " \n "    _dir = getDir fuelspawn;  " \n "    _veh = createVehicle [""FST_EXPLODEFUELBARREL_1"", _pad1, [], 0, ""CAN_COLLIDE""];  " \n "    _veh setDir _dir;  " \n "  " \n "    [""Fuel""] call addCrateStat;  " \n "    hint ""Fuel Barrel Dispensed!"";  " \n "}];  " \n "  " \n "  " \n " " \n " " \n " " \n "";
																																				disableSimulation=1;
																																			};
																																			id=1613;
																																			type="3AS_T_Screen";
																																			atlOffset=3.0517578e-005;
																																		};
