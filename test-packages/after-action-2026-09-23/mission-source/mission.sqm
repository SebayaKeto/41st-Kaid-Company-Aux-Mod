																																		class Item543
																																		{
																																			dataType="Trigger";
																																			position[]={625.25555,250.9111,344.91293};
																																			angle=1.6276168;
																																			class Attributes
																																			{
																																				onActivation="if (isNil ""ACE_healLoop"") then {" \n "    ACE_healLoop = [] spawn {" \n "        private _prop = medDroid;" \n "        private _radius = 2;        private _interval = 1;" \n "        private _healRate = 0.1;" \n "        while {alive _prop} do {" \n "            private _nearPlayers = allPlayers select {alive _x && (_x distance _prop) <= _radius};" \n "" \n "            if ((count _nearPlayers) > 0) then {" \n "                {" \n "                                        [_x, _x] call ace_medical_treatment_fnc_fullHeal;" \n "" \n "                    _x setVariable [""ace_medical_bloodVolume"", 6, true];" \n "                } forEach _nearPlayers;" \n "            };" \n "" \n "            sleep _interval;" \n "        };" \n "    };" \n "};" \n "";
																																				sizeA=2;
																																				sizeB=2;
																																				sizeC=3;
																																				repeatable=1;
																																				activationBy="ANY";
																																			};
																																			id=1814;
																																			type="EmptyDetector";
																																			atlOffset=0.17280579;
																																		};
