																	init="if(isServer) then { " \n " [this] spawn { " \n "  params [""_logic""]; " \n "   " \n "  sleep 2; " \n "   " \n "  _configAttackType = [""Man"",""Car"",""Tank"",""Helicopter"",""Plane""]; " \n "  _configTargetRange = 10000; " \n "  _configWaveCooldown = 240; " \n "   " \n "  _syncedConsoles = synchronizedObjects _logic; " \n "   " \n "  while {true} do { " \n "   { " \n "    if(_x getVariable ""autoAirSpawn"") then { " \n "     _pos = getPos _x; " \n "      " \n "     _newPos = _x modelToWorld [50,0,-30]; " \n "      " \n "     _nearestunits = nearestObjects [_pos, _configAttackType, _configTargetRange]; " \n "     _nearestfriendlies = []; " \n "      " \n "     if(blufor countSide _nearestunits > 0) then {  " \n "      {if(side _x == blufor) then{_nearestfriendlies = _nearestfriendlies + [_x]};} foreach _nearestunits; " \n "     }; " \n "      " \n "     if (!(isNull (_nearestfriendlies select 0))) then { " \n "      _group = [_newPos, east, [""3AS_CIS_VULTURE_F""],[],[],[],[],[],180] call BIS_fnc_spawnGroup; " \n " " \n "      _group move position (_nearestfriendlies select 0); " \n "     }; " \n "    }; " \n "     " \n "    sleep 2; " \n "     " \n "   } foreach _syncedConsoles; " \n "    " \n "   sleep _configWaveCooldown; " \n "  } " \n " }; " \n "};";
